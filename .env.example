# MongoDB Atlas Cloud Connection
# Get connection string from: mongodb cloud.mongodb.com → Database → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# IMPORTANT: URL-encode password if contains special characters
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/cms-production?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (change in production)
JWT_SECRET=your-secret-key-change-in-production

# AI Configuration - Gemini API
# AI_PROVIDER must be 'gemini' - no fallback to mock on config errors
AI_PROVIDER=gemini
# Get API key from: https://aistudio.google.com/apikey
# Free tier limited to ~10 requests/minute - see https://ai.google.dev/pricing
GEMINI_API_KEY=your-gemini-api-key-from-aistudio
# Model dùng cho phân tích video multimodal (Gemini Files API) - xem
# server/config/env.ts::GEMINI_MODEL. Available models (kiểm tra lại tại
# https://ai.google.dev/gemini-api/docs/models trước khi đổi):
# gemini-3.6-flash (mới nhất, khuyến nghị cho multimodal), gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-3.6-flash
# Số lần retry tối đa khi Gemini trả 429 (rate limit) / 503 (overloaded)
GEMINI_MAX_RETRIES=5

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Scheduled Jobs
# CHƯA IMPLEMENT: không có cron/scheduler nào trong server/ đọc 3 biến dưới
# đây (node-cron có trong package.json nhưng chưa được dùng ở đâu cả). Giữ
# lại làm placeholder cho tính năng tự động archive/rank trong tương lai -
# đừng tưởng lầm là đã hoạt động.
ENABLE_AUTO_ARCHIVE=true
AUTO_ARCHIVE_DAYS=90
ENABLE_AUTO_RANK=true

# TikTok data provider configuration
# Choose one provider such as Apify, EnsembleData, or TikAPI.
# Leave empty to use mock fallback data for local testing.
TIKTOK_PROVIDER=apify
APIFY_API_TOKEN=
APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper
# Tên Key-Value Store Apify dùng để lưu video đã tải (tầng chính trong chiến
# lược tải video 3 tầng: Apify KV store -> yt-dlp -> text_only). Giai đoạn 1
# chỉ khai báo, chưa có service nào gọi.
APIFY_KV_STORE_NAME=tiktok-videos
# Số video tối đa lấy về mỗi lần scrape
APIFY_MAX_ITEMS=30
# Số video "cào rộng" ở PASS 1 (discover, KHÔNG tải video - rẻ) trước khi chỉ
# tải THẬT đúng topN video đã chọn ở PASS 2 (hydrate, có tải video - đắt).
# QUAN TRỌNG: đây là số item MỖI HASHTAG, KHÔNG PHẢI tổng - actor tính
# resultsPerPage theo từng hashtag. 3 hashtag x 15 = ~45 item bị cào ở PASS 1.
# Đây là đòn bẩy chi phí THẬT của cả pipeline (đã verify bằng chạy thật) -
# giảm số này để giảm chi phí, KHÔNG phải tắt tải video.
# Xem server/services/tiktokService.ts::discoverTrendVideos/hydrateVideoDownloads.
APIFY_DISCOVERY_LIMIT=15

# Video download pipeline (Giai đoạn 2+) - xem server/config/env.ts
# Thư mục tạm lưu video trước khi upload Gemini, dọn ngay sau khi phân tích
# xong (không dùng cloud storage - xem quyết định B "Lưu video ở đâu?").
# Để trống để dùng mặc định: <os tmpdir>/tn-videos
VIDEO_TMP_DIR=
# Giới hạn dung lượng 1 video được tải về (MB)
VIDEO_MAX_SIZE_MB=100
# Bật/tắt tầng dự phòng yt-dlp khi Apify KV store không trả về file video
ENABLE_YTDLP_FALLBACK=true

# MongoDB Atlas Network Security
# Whitelist your IP in MongoDB Atlas: cloud.mongodb.com → Network Access
# For development: Can use 0.0.0.0/0 but NOT recommended for production
